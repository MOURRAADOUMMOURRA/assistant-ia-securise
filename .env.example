# ---------------------------------------------------------------------------
# Modèle de configuration de l'Assistant IA interne sécurisé.
# Copiez ce fichier en « .env » (Copy-Item .env.example .env), puis modifiez
# les valeurs. Le fichier .env n'est jamais publié (voir .gitignore).
# ---------------------------------------------------------------------------

# --- Accès à l'interface ----------------------------------------------------
# Mot de passe de démonstration. Valeur d'exemple : CHANGEZ-LA dans votre .env.
ASSISTANT_DEMO_PASSWORD=changez-moi-avant-la-demo

# --- Ollama (serveur local de modèles) --------------------------------------
# Adresse locale d'Ollama. Ne mettez jamais une adresse distante.
ASSISTANT_OLLAMA_HOST=http://127.0.0.1:11434
ASSISTANT_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
ASSISTANT_EMBED_MODEL=bge-m3
# Durée pendant laquelle Ollama garde les modèles en mémoire entre deux questions.
ASSISTANT_OLLAMA_KEEP_ALIVE=30m
# Délai maximal d'attente d'une réponse d'Ollama, en secondes.
ASSISTANT_OLLAMA_TIMEOUT_S=180

# --- Génération -------------------------------------------------------------
# Température basse = réponses factuelles et stables.
ASSISTANT_LLM_TEMPERATURE=0.1
# Taille de la fenêtre de contexte (en tokens). Raisonnable pour un CPU.
ASSISTANT_LLM_NUM_CTX=4096
# Longueur maximale de la réponse (en tokens). Réponses courtes.
ASSISTANT_LLM_NUM_PREDICT=300

# --- Découpage des documents ------------------------------------------------
ASSISTANT_CHUNK_SIZE=900
ASSISTANT_CHUNK_OVERLAP=150

# --- Recherche --------------------------------------------------------------
# Nombre d'extraits récupérés pour chaque question.
ASSISTANT_TOP_K=5
# Similarité minimale (entre 0 et 1). En dessous : refus sans appeler le LLM.
# Valeur provisoire, calibrée en phase 7.
ASSISTANT_SIMILARITY_THRESHOLD=0.5

# --- Dossiers (relatifs à la racine du projet) ------------------------------
ASSISTANT_DOCS_DIR=demo_docs
ASSISTANT_INDEX_DIR=data/index
ASSISTANT_LOGS_DIR=logs

# --- Journal ----------------------------------------------------------------
# Niveau : DEBUG, INFO, WARNING, ERROR.
ASSISTANT_LOG_LEVEL=INFO

# --- Mode doublure (tests uniquement) ---------------------------------------
# ALLOW_MOCK=true autorise le mode doublure : de faux modèles locaux (sans Ollama)
# pour tester le parcours. Les réponses ne sont alors PAS générées par une IA.
# Laissez false pour une démo client : la bascule n'apparaît pas.
ASSISTANT_ALLOW_MOCK=false
# TEST_DOUBLE=true impose le mode doublure (sans effet si ALLOW_MOCK=false).
ASSISTANT_TEST_DOUBLE=false
